msgstr "建一座塔"

msgid "MISSION_FUTURECITY_MEDAL_3_IMPLEMENT_SUB1"
msgstr "載運工人"

msgid "MISSION_FUTURECITY_MEDAL_3_IMPLEMENT_TASK"
msgstr "需集齊工人與工程原料，方可建造此建築。"

msgid "MISSION_FUTURECITY_MEDAL_3_IMPLEMENT_TEXT"
msgstr "需有足夠人力，方可建造此建築。"

