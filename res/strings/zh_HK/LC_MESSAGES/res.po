msgstr "蘇黎世"

msgid "MISSION_ALLINCLUSIVE_PARAMS_ZURICH_BUS1"
msgstr "蘇黎世巴士 1"

msgid "MISSION_ALLINCLUSIVE_PARAMS_ZURICH_BUS2"
msgstr "蘇黎世巴士 2"

