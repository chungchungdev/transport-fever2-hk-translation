msgstr "南充市"

msgid "MISSION_REDSTAR_PARAMS_NEIJIANG"
msgstr "內江市"

msgid "MISSION_REDSTAR_PARAMS_STEELMILL_EAST"
msgstr "重慶市煉鋼廠"

msgid "MISSION_REDSTAR_PARAMS_STEELMILL_WEST"
msgstr "自貢市煉鋼廠"

