msgid "MISSION_FUTURECITY_MEDAL_1_IMPLEMENT_TEXTA"
msgstr ""
"Eres responsable de la exportación de bienes.\n"
"Esto requiere lograr los objetivos apropiados."

msgid "MISSION_FUTURECITY_MEDAL_1_IMPLEMENT_TEXTB"
msgstr ""
"Eres responsable de la importación de bienes.\n"
"Esto requiere lograr los objetivos apropiados."

msgid "MISSION_FUTURECITY_MEDAL_1_NAME"
msgstr "Puerto marítimo"

msgid "MISSION_FUTURECITY_MEDAL_1_TEXT"
msgstr ""
"El puerto marítimo de Yangshán permite la importación y exportación de "
"bienes.\n"
"Puedes elegir cuál de estos servicios ofrecer."

