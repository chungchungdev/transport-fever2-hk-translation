msgstr "Control"

msgid "MISSION_FUTURECITY_MEDAL_2_FINISH_NAME"
msgstr "Vista general obtenida"

msgid "MISSION_FUTURECITY_MEDAL_2_FINISH_TEXT"
msgstr ""
"Objetivo cumplido.\n"
"El control de los residentes está garantizado."

