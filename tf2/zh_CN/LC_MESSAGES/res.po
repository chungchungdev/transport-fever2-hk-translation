msgid "GUIDE_BUILD_BUS_STATION_CARGO"
msgstr "建造公路货运站进行公路运输。"

msgid "GUIDE_BUILD_BUS_STATION_PASSENGER"
msgstr "建造公交站进行公路运输。"

msgid "GUIDE_BUILD_BUS_STOP"
msgstr "公交很适合承担城市的市内交通，有许多种公交站可选择。"

msgid "GUIDE_BUILD_DOCK"
msgstr "必须先建造船坞，才能购买船舶。"

msgid "GUIDE_BUILD_HARBOR"
msgstr "必须现有码头船舶才能运作。"

msgid "GUIDE_BUILD_SIGNALS"
msgstr "可以在轨旁设置信号机控制铁路交通。"

msgid "GUIDE_BUILD_STATIONS"
msgstr "在城市或产业区建造火车站，运送旅客或货物。"

msgid "GUIDE_BUILD_STREETS"
msgstr "建造街道连接车站与车场。"

msgid "GUIDE_BUILD_TRACKS"
msgstr "建造轨道连接火车站与车辆段。"

msgid "GUIDE_BUILD_TRAIN_DEPOT"
msgstr "必须先建造车辆段才能购买列车。"

msgid "GUIDE_BUILD_TRAIN_STATION_CARGO"
msgstr "建造货运火车站，通过铁路运输货物。"

msgid "GUIDE_BUILD_TRAIN_STATION_PASSENGER"
msgstr "建造火车站，通过铁路运送乘客。"

msgid "GUIDE_BULLDOZER"
msgstr "使用拆迁按钮可以基础设施以及任何其他东西。"

msgid "GUIDE_CAMERA_BUTTON"
msgstr "用照片工具可以拍出不同焦距的截图和录像。"

msgid "GUIDE_CLOSE_ALL"
msgstr "按住 [iaHint=IA_CLOSE_ALL_LONGPRESS/] 关闭所有开启的窗口和菜单。"

msgid "GUIDE_COCKPIT_VIEW"
msgstr "选取载具窗口的高亮按钮，可切换到舱室视角。"

msgid "GUIDE_COMPANY_FINANCES"
msgstr "公司财务可以显示最近年份的收入与支出。"

msgid "GUIDE_COMPANY_GROWTH"
msgstr "有许多类型的图表可以反映公司的发展。"

msgid "GUIDE_COMPANY_HEAD_QUARTER"
msgstr "选择一个地点建造公司的总部。"

msgid "GUIDE_COMPANY_LOGO"
msgstr "可以选择公司标志。选择后，所有交通工具上都可以看到该标志。"

msgid "GUIDE_CONTOURS_BUTTON"
msgstr ""
"地形过于陡峭时，无法在其上建造轨道、街道或车站。有专门图层可以显示等高线。"

msgid "GUIDE_CONTROLLER_PAN"
msgstr "使用 [iaHint=IA_CAMERA_PAN/] 移动摄影视角。"

msgid "GUIDE_CONTROLLER_ROTATE"
msgstr "使用 [iaHint=IA_CAMERA_ROTATE_X/] 旋转摄影视角。"

msgid "GUIDE_CONTROLLER_ZOOM"
msgstr ""
"使用 [iaHint=IA_CAMERA_ZOOM_IN/] 和 [iaHint=IA_CAMERA_ZOOM_OUT/] 缩放摄影视"
"角。"

msgid "GUIDE_CREATE_LINE"
msgstr "在高亮的窗口新建线路。"

msgid "GUIDE_EMISSION_LAYER_BUTTON"
msgstr "交通工具排放会减缓城市发展。有专门图层可以显示排放高的地区。"

msgid "GUIDE_GAME_SPEED"
msgstr "除了暂停模式外，还有另外三种游戏速度可选择：真实速度、两倍速及四倍速。"

msgid "GUIDE_GAME_SPEED_COUCH"
msgstr ""
"除了暂停模式外，还有另外三种游戏速度可选择：真实速度、两倍速及四倍速。按住 "
"[iaHint=IA_GAME_PAUSE_OR_CYCLE_SPEED/] 更改游戏速度。"

msgid "GUIDE_HUD_ICONS"
msgstr "HUD菜单的每个图标可以切换开或关。"

msgid "GUIDE_INSPECTOR"
msgstr "使用视察工具选取游戏世界中的物件并查看详细信息。"

msgid "GUIDE_KEY_SCROLL"
msgstr ""
"使用 [iaHint=cameraMoveUp/]、[iaHint=cameraMoveLeft/]、"
"[iaHint=cameraMoveDown/] 和 [iaHint=cameraMoveRight/] 键移动视角。"

msgid "GUIDE_LANDUSE_BUTTON"
msgstr "建筑物的用途有三种。有专门图层可以将三种区域显示出来。"

msgid "GUIDE_LAYERS"
msgstr "图层功能可以展示特定的信息。"

msgid "GUIDE_LOCATE_BUTTON"
msgstr "点击任务窗口左上角的按钮可将视角移动到事件的发生地点。"

msgid "GUIDE_MOUSE_PAN"
msgstr "按住鼠标右键后，再移动鼠标，可移动视角。"

msgid "GUIDE_MOUSE_ROTATE"
msgstr ""
"按柱鼠标中键后，再移动鼠标，可转动视角。\n"
"\n"
"备选：使用[iaHint=cameraRotateLeft/]或[iaHint=cameraRotateRight/]"

msgid "GUIDE_MOUSE_WHEEL"
msgstr ""
"使用鼠标滚轮缩放视角\n"
"\n"
"备选：使用[iaHint=cameraZoomIn/]和[iaHint=cameraZoomOut/]按钮。"

msgid "GUIDE_MUSIC_PLAYER_BUTTON"
msgstr "随时都可以暂停或切换正在播放的音乐。"

msgid "GUIDE_OPEN_CLOSE_WINDOW"
msgstr ""
"使用 [iaHint=IA_MENU_BACK/] 关闭任务窗口。\n"
"您可以使用 [iaHint=IA_CAMPAIGN_MISSION_MENU_OPEN/] 重新打开任务窗口。"

msgid "GUIDE_OPEN_TOWN_WINDOW"
msgstr "城镇的成长会受到好几个因素影响。选择城镇名称可查看更多信息。"

msgid "GUIDE_REPAY_LOAN"
msgstr "只要资金足够，可以一次性全额还清贷款或只先还一部分。"

msgid "GUIDE_ROTATE_CONSTRUCTIONS"
msgstr ""
"按 [iaHint=constructOpt2/] 和 [iaHint=constructOpt1/] 旋转建造物的朝向。"

msgid "GUIDE_SAVE_GAME_BUTTON"
msgstr "定期保存游戏是好习惯，保存的操作随时都可以进行。"

msgid "GUIDE_SETTINGS_BUTTON"
msgstr "可以随时修改图形、声音、快捷键和其他设置。"

msgid "GUIDE_SPEED_LIMITS_BUTTON"
msgstr "铁轨有各种不同的限速。有专门图层可以显示限速。"

msgid "GUIDE_STATION_QUALITY"
msgstr ""
"有一个站点服务能力不足了。在这样的站点，货物会丢失，乘客会离去。此外，超员的"
"客运站对全市镇的经济增长会产生负面影响。"

msgid "GUIDE_STATS"
msgstr "统计窗口显示您的交通公司各方面最重要的信息。"

msgid "GUIDE_STATS_INDUSTRIES_BUTTON"
msgstr "产业统计可以显示产业当前的产量等重要信息。"

msgid "GUIDE_STATS_LINES_BUTTON"
msgstr "道路统计可以显示所有线路的到站率、载运率和收益率等重要信息。"

msgid "GUIDE_STATS_STATIONS_BUTTON"
msgstr "站点统计可以显示所有车站的利用率等重要信息。"

msgid "GUIDE_STATS_TOWNS_BUTTON"
msgstr "城市统计可以显示所有城市的居民数量等重要信息。"

msgid "GUIDE_STATS_VEHICLES_BUTTON"
msgstr "交通工具统计可以显示所有交通工具的状态、车龄和年度收益率等重要信息。"

msgid "GUIDE_TRACK_MODIFIER"
msgstr "重建工具可以在不执行拆除动作的情况下修改街道。"

msgid "GUIDE_TRAFFIC_LAYER_BUTTON"
msgstr ""
"当前的交通状况和交通阻塞会减缓城市发展。有专门图层可以显示交通的顺畅度。"

msgid "GUIDE_UNPAUSE"
msgstr "目前游戏已经暂停。使用游戏速度菜单恢复游戏运行。"

msgid "GUIDE_UNPAUSE_COUCH"
msgstr ""
"目前游戏已经暂停。按下 [iaHint=IA_GAME_PAUSE_OR_CYCLE_SPEED/] 恢复游戏运行。"

msgid "GUIDE_VEHICLE_EXHAUSTED"
msgstr "老化的交通工具会造成额外的排放污染。您可以通过维护或替换以减少污染。"

msgid "GUIDE_WARNINGS"
msgstr "警告清单发布了，请打开清单查看详情。"

msgid "GUIDE_WATERS_BUTTON"
msgstr "船舶只能在适航水域航行。有专门图层可以显示适航水域。"

