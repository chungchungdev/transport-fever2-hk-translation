msgstr "Atenda a todos os requisitos."

msgid "MISSION_FUTURECITY_MEDAL_3_IMPLEMENT_TEXT"
msgstr "Construir a estrutura exige mão de obra."

msgid "MISSION_FUTURECITY_MEDAL_3_NAME"
msgstr "Torre Pérola Oriental"

msgid "MISSION_FUTURECITY_MEDAL_3_TEXT"
msgstr ""
"Xangai precisa de um novo marco.\n"
"Há a opção de construir a estrutura."

