msgid "MISSION_FUTURECITY_MEDAL_2_IMPLEMENT_TASKB"
msgstr "Crie um valor de estações lotadas de ${transportrating_formated}."

msgid "MISSION_FUTURECITY_MEDAL_2_IMPLEMENT_TEXTA"
msgstr ""
"Monitorar a população na estrada requer que os veículos particulares "
"circulem em baixa velocidade."

msgid "MISSION_FUTURECITY_MEDAL_2_IMPLEMENT_TEXTB"
msgstr ""
"Monitorar a população no transporte público requer que todos fiquem um tempo "
"nas estações."

msgid "MISSION_FUTURECITY_MEDAL_2_NAME"
msgstr "Controle"

msgid "MISSION_FUTURECITY_MEDAL_2_TEXT"
msgstr ""
"Medidas que envolvem tecnologia de transporte permitem capturar e registrar "
"os padrões de movimentação dos habitantes.\n"
"Há a opção de monitorar a população urbana."

