msgstr "Bouwplaats dam"

msgid "MISSION_REDSTAR_PARAMS_GUANGAN"
msgstr "Guang’an"

msgid "MISSION_REDSTAR_PARAMS_IRONMINE_EAST"
msgstr "IJzerertsmijn Chongqing"

msgid "MISSION_REDSTAR_PARAMS_IRONMINE_WEST"
msgstr "IJzerertsmijn Leshan"

